# ============================================================================
# MediData backend environment
# Copy this file to backend/.env and fill in the two database URLs.
# ALL DATA IS SYNTHETIC — never point this at a real clinical database.
# ============================================================================

# --- Database (required) ----------------------------------------------------
# Neon: use the POOLED connection string for the app (port 5432).
# Neon free tier has NO BAA, which is why this project is synthetic-only.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.aws.neon.tech:5432/neondb?sslmode=require"
# Use the UNPOOLED (direct) string for migrations (`prisma migrate deploy`).
DIRECT_URL="postgresql://user:password@ep-xxxx.aws.neon.tech:5432/neondb?sslmode=require"

# --- Auth (required in production) ------------------------------------------
# Development falls back to an insecure default. Set a long random value.
JWT_SECRET="change-me-to-a-long-random-string"
JWT_TTL_SECONDS=28800

# --- Inbound webhooks (optional) -------------------------------------------
# HMAC-SHA256 secret for /webhooks/*. Falls back to JWT_SECRET when unset.
# Unsigned inbound requests are accepted outside production.
WEBHOOK_SECRET="change-me-to-a-long-random-string"

# --- Redis (optional) -------------------------------------------------------
# The worker uses in-process node-cron, so Redis is NOT required for the demo.
# Set this only if you swap the scheduler for BullMQ.
# REDIS_URL="rediss://default:password@upstash.io:6379"

# --- Object storage (optional) ---------------------------------------------
# Without S3, the patient portal serves synthetic PDF result downloads from a
# data URL. Set these to use a real S3-compatible bucket instead.
# S3_BUCKET="medidata-documents"
# S3_REGION="ap-southeast-1"
# AWS_S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"

# --- HTTP -------------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# --- Worker schedules (optional) -------------------------------------------
# Standard 5-field cron expressions. The worker also runs ETL/DQ once at boot.
# WORKER_ETL_CRON="*/15 * * * *"
# WORKER_FRESHNESS_CRON="*/5 * * * *"
# WORKER_OUTBOX_CRON="* * * * *"
# WORKER_RUN_ON_BOOT=false

# --- Frontend (optional; used when running the web app) --------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
WEB_PORT=3000
